{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Edit(.env*)",
      "Edit(**/*.key)",
      "Bash(rm *)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/session_start.sh 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
